{
  "name": "arena-shooter",
  "private": true,
  "version": "0.1.0",
  "description": "Shooter arena multijugador para navegador con servidor autoritativo.",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c yellow,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "test": "npm test --workspace server",
    "typecheck": "tsc -p server && tsc -p client"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "concurrently": "9.2.5"
  }
}
